# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (e-mail lookup + push)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública do app (links nos e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail via Resend (opcional — sem key = só notificação in-app)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Family Issues <onboarding@resend.dev>

# Web Push VAPID (opcional — gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@email.com
